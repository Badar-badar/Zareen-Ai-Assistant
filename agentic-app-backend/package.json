{
  "name": "agentic-app-backend",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "test": "vitest run",
    "dev": "npx tsx watch --env-file=.env index.ts",
    "start": "npx tsx --env-file=.env index.ts",
    "ingest": "npx tsx --env-file=.env src/rag/ingest.ts src/data/rag_docs",
    "rag:ingest": "tsx --env-file=.env src/rag/ingest.ts src/data/rag_docs",
    "rag:view": "npx tsx --env-file=.env -e \"import { ChromaClient } from 'chromadb'; const c = new ChromaClient({ host: 'localhost', port: 8000, ssl: false }); (async () => { const col = await c.getCollection({ name: 'rag_docs' }); console.log('Count:', await col.count()); console.log(await col.get({ limit: 5 })); })()\"",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "rag:eval": "tsx --env-file=.env src/rag/eval/run.ts",
    "eval:agent": "tsx --env-file=.env src/eval/run.ts",
    "eval:routing": "tsx --env-file=.env src/eval/routing.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.9",
    "@google/genai": "^2.19.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chromadb": "^3.5.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "jose": "^6.2.12",
    "mongoose": "^9.11.0",
    "mongoosh": "^0.0.7",
    "openai": "^7.10.0",
    "pg": "^8.23.0",
    "pgvector": "^0.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
